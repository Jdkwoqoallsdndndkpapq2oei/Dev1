-- Fly System
local function startTpWalk()
	TpWalking = false
	task.wait(0.02)
	if not Config.FlyEnabled then return end

	TpWalking = true
	for _ = 1, Config.FlySpeedMultiplier do
		task.spawn(function()
			while TpWalking and Config.FlyEnabled do
				RunService.Heartbeat:Wait()
				local chr = LocalPlayer.Character
				local hum = chr and chr:FindFirstChildWhichIsA("Humanoid")
				if chr and hum and hum.Parent and hum.MoveDirection.Magnitude > 0 then
					chr:TranslateBy(hum.MoveDirection)
				end
			end
		end)
	end
end

local function setFlyState(state)
	Config.FlyEnabled = state
	saveConfig()
	if FlyToggleSync then
		FlyToggleSync(state)
	end

	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildWhichIsA("Humanoid")
	if not char or not hum then return end

	local states = {
		Enum.HumanoidStateType.Climbing,
		Enum.HumanoidStateType.FallingDown,
		Enum.HumanoidStateType.Flying,
		Enum.HumanoidStateType.Freefall,
		Enum.HumanoidStateType.GettingUp,
		Enum.HumanoidStateType.Jumping,
		Enum.HumanoidStateType.Landed,
		Enum.HumanoidStateType.Physics,
		Enum.HumanoidStateType.PlatformStanding,
		Enum.HumanoidStateType.Ragdoll,
		Enum.HumanoidStateType.Running,
		Enum.HumanoidStateType.RunningNoPhysics,
		Enum.HumanoidStateType.Seated,
		Enum.HumanoidStateType.StrafingNoPhysics,
		Enum.HumanoidStateType.Swimming,
	}

	if not Config.FlyEnabled then
		TpWalking = false
		hum.PlatformStand = false

		for _, s in ipairs(states) do
			hum:SetStateEnabled(s, true)
		end
		hum:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)

		if char:FindFirstChild("Animate") then
			char.Animate.Disabled = false
		end
	else
		startTpWalk()

		if char:FindFirstChild("Animate") then
			char.Animate.Disabled = true
		end

		for _, trackAnim in ipairs(hum:GetPlayingAnimationTracks()) do
			trackAnim:AdjustSpeed(0)
		end

		for _, s in ipairs(states) do
			hum:SetStateEnabled(s, false)
		end
		hum:ChangeState(Enum.HumanoidStateType.Swimming)

		task.spawn(function()
			local rootTorso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
			if not rootTorso then return end

			local oldBg = rootTorso:FindFirstChild("BlackShadowFlyGyro")
			if oldBg then oldBg:Destroy() end
			local oldBv = rootTorso:FindFirstChild("BlackShadowFlyVel")
			if oldBv then oldBv:Destroy() end

			local bg = create("BodyGyro", {
				Name = "BlackShadowFlyGyro",
				P = 9e4,
				MaxTorque = Vector3.new(9e9, 9e9, 9e9),
				CFrame = rootTorso.CFrame,
			}, rootTorso)

			local bv = create("BodyVelocity", {
				Name = "BlackShadowFlyVel",
				Velocity = Vector3.new(0, 0.1, 0),
				MaxForce = Vector3.new(9e9, 9e9, 9e9),
			}, rootTorso)

			hum.PlatformStand = true

			while Config.FlyEnabled and hum.Health > 0 and rootTorso.Parent do
				RunService.RenderStepped:Wait()
				local cam = workspace.CurrentCamera
				local moveDir = hum.MoveDirection

				if cam and moveDir.Magnitude > 0 then
					bv.Velocity = cam.CFrame.LookVector * (moveDir.Magnitude * 25) + Vector3.new(0, 0.1, 0)
				else
					bv.Velocity = Vector3.new(0, 0, 0)
				end

				if cam then
					bg.CFrame = cam.CFrame
				end
			end

			if bg and bg.Parent then bg:Destroy() end
			if bv and bv.Parent then bv:Destroy() end
		end)
	end
end

local function applyNoFog()
	Lighting.FogEnd = 1e9
	Lighting.FogStart = 1e9
	for _, obj in ipairs(Lighting:GetDescendants()) do
		if obj:IsA("Atmosphere") then
			obj.Density = 0
		elseif obj:IsA("Fog") then
			obj.Enabled = false
		end
	end
end

local function restoreFog()
	Lighting.FogEnd = SavedFog.FogEnd
	Lighting.FogStart = SavedFog.FogStart
	Lighting.FogColor = SavedFog.FogColor
end

local function giveTeleportTool()
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	if not backpack then return end

	local oldTool = backpack:FindFirstChild("TP Tool")
	if oldTool then oldTool:Destroy() end

	local char = LocalPlayer.Character
	local equippedOld = char and char:FindFirstChild("TP Tool")
	if equippedOld then equippedOld:Destroy() end

	local tool = Instance.new("Tool")
	tool.Name = "TP Tool"
	tool.RequiresHandle = false
	tool.CanBeDropped = false
	tool.Parent = backpack

	tool.Activated:Connect(function()
		local mouse = LocalPlayer:GetMouse()
		local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		if mouse and mouse.Hit and root then
			root.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
		end
	end)
end

local function getOtherPlayers()
	local list = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			table.insert(list, plr)
		end
	end
	return list
end

local function teleportToPlayer(target)
	if not target or not target.Character then return end
	local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
	local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	if targetRoot and myRoot then
		myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, -3)
	end
end

-- Adonis Anti-Cheat Bypass System
local function notifyAntiCheat(title, text, duration)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = duration or 3,
		})
	end)
end

local function BypassAdonisAnticheat()
	Config.AdonisBypassEnabled = true
	if AdonisBypassToggleSync then
		AdonisBypassToggleSync(true)
	end

	if not (getreg and getgc and isfunctionhooked and hookfunction) then
		return false
	end

	local AdonisThreads = {}
	local AdonisDetected = false

	for _, thread in ipairs(getreg()) do
		if typeof(thread) == "thread" then
			local ok, source = pcall(debug.info, thread, 1, "s")
			if ok and source and (source:match("%.Core%.Anti") or source:match("%.Plugins%.Anti_Cheat")) then
				AdonisDetected = true
				table.insert(AdonisThreads, thread)
			end
		end
	end

	if not AdonisDetected then
		return false
	end

	notifyAntiCheat("Anti Cheat", "Anti Cheat Detected", 2)

	for _, thread in ipairs(AdonisThreads) do
		pcall(coroutine.close, thread)
	end

	local AdonisTables = {}

	if filtergc then
		local ok, candidates = pcall(filtergc, "table", {
			Keys = { "Detected", "RLocked" }
		}, false)
		if ok and type(candidates) == "table" then
			for _, tbl in ipairs(candidates) do
				if typeof(rawget(tbl, "Detected")) == "function" then
					table.insert(AdonisTables, tbl)
				end
			end
		end
	else
		local ok, gcList = pcall(getgc, true)
		if ok and type(gcList) == "table" then
			for _, tbl in ipairs(gcList) do
				if typeof(tbl) == "table" and typeof(rawget(tbl, "Detected")) == "function" and rawget(tbl, "RLocked") then
					table.insert(AdonisTables, tbl)
				end
			end
		end
	end

	for _, tbl in ipairs(AdonisTables) do
		for _, fn in pairs(tbl) do
			if typeof(fn) == "function" and not isfunctionhooked(fn) then
				pcall(function()
					hookfunction(fn, function()
						coroutine.yield()
						return task.wait(9e9)
					end)
				end)
			end
		end
	end

	task.defer(function()
		notifyAntiCheat("Anti Cheat", "Anti Cheat Bypassed", 3)
	end)

	return true
end

