local function saveConfig()
	Config.AdonisBypassEnabled = true
	if typeof(writefile) ~= "function" then
		return
	end
	pcall(function()
		local toSave = {
			ScriptUrl = Config.ScriptUrl,
			WalkSpeedEnabled = Config.WalkSpeedEnabled,
			WalkSpeedValue = Config.WalkSpeedValue,
			JumpPowerEnabled = Config.JumpPowerEnabled,
			JumpPowerValue = Config.JumpPowerValue,
			FlyEnabled = Config.FlyEnabled,
			FlySpeedMultiplier = Config.FlySpeedMultiplier,
			InfJumpEnabled = Config.InfJumpEnabled,
			NoclipEnabled = Config.NoclipEnabled,
			LoopNoFogEnabled = Config.LoopNoFogEnabled,
			AntiAfkEnabled = Config.AntiAfkEnabled,
			AutoRejoinOnKick = Config.AutoRejoinOnKick,
			AutoExecuteOnRejoin = Config.AutoExecuteOnRejoin,
			RejoinDelay = Config.RejoinDelay,
			AdonisBypassEnabled = true,
		}
		writefile(CONFIG_FILE, HttpService:JSONEncode(toSave))
	end)
end

local function loadConfig()
	if typeof(isfile) ~= "function" or typeof(readfile) ~= "function" then
		Config.AdonisBypassEnabled = true
		return
	end
	pcall(function()
		if isfile(CONFIG_FILE) then
			local raw = readfile(CONFIG_FILE)
			local decoded = HttpService:JSONDecode(raw)
			if type(decoded) == "table" then
				for k, v in pairs(decoded) do
					if Config[k] ~= nil and type(v) == type(Config[k]) then
						Config[k] = v
					end
				end
			end
		end
	end)
	Config.AdonisBypassEnabled = true
end

loadConfig()

