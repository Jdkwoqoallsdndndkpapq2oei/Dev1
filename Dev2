local function queueReExecute()
	local qot = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
	if qot and Config.ScriptUrl and Config.ScriptUrl ~= "" and Config.ScriptUrl ~= "YOUR_RAW_URL" then
		pcall(function()
			qot('loadstring(game:HttpGet("' .. Config.ScriptUrl .. '"))()')
		end)
	end
end

local function triggerRejoin()
	if Rejoining then return end
	Rejoining = true
	if Config.AutoExecuteOnRejoin then
		queueReExecute()
	end
	task.wait(Config.RejoinDelay)
	pcall(function()
		TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
	end)
	task.wait(2)
	pcall(function()
		TeleportService:Teleport(game.PlaceId, LocalPlayer)
	end)
	Rejoining = false
end

local function serverHop()
	if Config.AutoExecuteOnRejoin then
		queueReExecute()
	end
	local ok, res = pcall(function()
		local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId) .. "/servers/Public?sortOrder=Desc&limit=100"
		return HttpService:JSONDecode(game:HttpGet(url))
	end)
	if ok and res and res.data then
		for _, srv in ipairs(res.data) do
			if tostring(srv.id) ~= tostring(game.JobId) and tonumber(srv.playing) < tonumber(srv.maxPlayers) then
				pcall(function()
					TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, LocalPlayer)
				end)
				return
			end
		end
	end
	pcall(function()
		TeleportService:Teleport(game.PlaceId, LocalPlayer)
	end)
end

